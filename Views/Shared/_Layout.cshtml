<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Haftalık Hadis</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hadith.css" asp-append-version="true" />
</head>
<body>
    <header class="top-navbar">
        <div class="container d-flex justify-content-between align-items-center">
            <span class="brand-title">Haftalık Hadis</span>
            <span class="brand-subtitle">Ruhu besleyen haftalık içerik</span>
        </div>
    </header>

    <main class="main-wrapper container">
        @RenderBody()
    </main>

    <nav class="bottom-nav">
        <div class="container">
            <div class="nav d-flex justify-content-between">
                <a class="nav-link @(ViewData["ActivePage"] == "Home" ? "active" : "")" href="@Url.Action("Index", "Home")">
                    <i class="fas fa-home"></i>
                    Bu Ay
                </a>
                <a class="nav-link @(ViewData["ActivePage"] == "Archive" ? "active" : "")" href="@Url.Action("ListHadiths", "Admin")">
                    <i class="fas fa-archive"></i>
                    Arşiv
                </a>
                <a class="nav-link @(ViewData["ActivePage"] == "Settings" ? "active" : "")" href="@Url.Action("Settings", "Home")">
                    <i class="fas fa-cog"></i>
                    Ayarlar
                </a>
            </div>
        </div>
    </nav>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
