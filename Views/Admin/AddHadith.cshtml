@model Alhadis.Models.AdminAddHadithInputModel
@{
    ViewData["Title"] = "Hadis Ekle";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white">
        <h2 class="h5 mb-0"><i class="fas fa-book-medical me-2"></i>Yeni Hadis Ekle</h2>
    </div>

    <div class="card-body">
        <form asp-action="AddHadith" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="YearNumber" class="form-label"></label>
                    <input asp-for="YearNumber" class="form-control" placeholder="2026" />
                    <span asp-validation-for="YearNumber" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="MonthName" class="form-label"></label>
                    <input asp-for="MonthName" class="form-control" placeholder="Ocak" />
                    <span asp-validation-for="MonthName" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="WeekNumber" class="form-label"></label>
                    <input asp-for="WeekNumber" class="form-control" />
                    <span asp-validation-for="WeekNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="TurkishContent" class="form-label"></label>
                <textarea asp-for="TurkishContent" class="form-control" rows="3"></textarea>
                <span asp-validation-for="TurkishContent" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ArabicContent" class="form-label"></label>
                <textarea asp-for="ArabicContent" class="form-control" rows="3" dir="rtl"></textarea>
                <span asp-validation-for="ArabicContent" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OromicContent" class="form-label"></label>
                <textarea asp-for="OromicContent" class="form-control" rows="3"></textarea>
                <span asp-validation-for="OromicContent" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="AmharicContent" class="form-label"></label>
                <textarea asp-for="AmharicContent" class="form-control" rows="3"></textarea>
                <span asp-validation-for="AmharicContent" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-2"></i>Kaydet
            </button>
            <a href="@Url.Action("ListHadiths")" class="btn btn-outline-secondary ms-2">Vazgeç</a>
        </form>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />
