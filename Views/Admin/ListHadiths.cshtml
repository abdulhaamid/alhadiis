@model IEnumerable<Alhadis.Models.Hadith>
@{
    ViewData["Title"] = "Hadis Arşivi";
}

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="d-flex justify-content-end mb-3">
    <a href="@Url.Action("AddHadith")" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Yeni Hadis
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-light">
        <h2 class="h5 mb-0">Hadis Kayıtları</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Yıl</th>
                    <th>Ay</th>
                    <th>Hafta</th>
                    <th>Dil</th>
                    <th>İçerik</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var hadith in Model)
                {
                    <tr>
                        <td>@hadith.Week.Month.Year.YearNumber</td>
                        <td>@hadith.Week.Month.MonthName</td>
                        <td>@hadith.Week.WeekNumber</td>
                        <td><span class="badge @GetLanguageBadge(hadith.Language.Name)">@hadith.Language.Name</span></td>
                        <td style="max-width:460px">
                            <div class="text-truncate">@hadith.Content</div>
                        </td>
                        <td class="text-end">
                            <a href="@Url.Action("EditHadith", new { id = hadith.Id })" class="btn btn-sm btn-outline-warning me-1"><i class="fas fa-pen"></i></a>
                            <a href="@Url.Action("DeleteHadith", new { id = hadith.Id })" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    string GetLanguageBadge(string language) => language switch
    {
        "Türkçe" => "bg-success",
        "Arapça" => "bg-danger",
        "Oromiçe" => "bg-info text-dark",
        "Amhariçe" => "bg-dark",
        _ => "bg-secondary"
    };
}
