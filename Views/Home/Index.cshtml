@model Alhadis.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Haftalık Hadis";
}

<div class="hadith-page">
    <div class="hero-card">
        <h1 class="hero-title">Haftalık Hadis</h1>
        <p class="hero-subtitle">Yıl, ay, hafta ve dil seçerek içeriği anında görüntüleyin.</p>
    </div>

    <div class="filters-card">
        <div class="filter-group">
            <label for="yearSelect">Yıl</label>
            <select id="yearSelect" class="form-select">
                @foreach (var year in Model.Years)
                {
                    <option value="@year.YearNumber" selected="@(year.YearNumber == Model.SelectedYear)">@year.YearNumber</option>
                }
            </select>
        </div>

        <div class="filter-group">
            <label for="monthSelect">Ay</label>
            <select id="monthSelect" class="form-select">
                @foreach (var month in Model.Months)
                {
                    <option value="@month.Id" selected="@(month.Id == Model.SelectedMonthId)">@month.MonthName</option>
                }
            </select>
        </div>
    </div>

    <div class="week-tabs" id="weekTabs">
        @foreach (var week in Model.Weeks)
        {
            <button type="button"
                    class="chip-btn @(week.WeekNumber == Model.SelectedWeekNumber ? "active" : string.Empty)"
                    data-week="@week.WeekNumber">
                @week.WeekNumber. Hafta
            </button>
        }
    </div>

    <div class="hadith-card" id="hadithCard">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-warning mb-0">@Model.ErrorMessage</div>
        }
        else if (Model.Hadith is null)
        {
            <div class="empty-state">Seçili filtreler için hadis bulunamadı.</div>
        }
        else
        {
            <div class="hadith-reference" id="hadithReference">
                @Model.Hadith.Week.Month.Year.YearNumber - @Model.Hadith.Week.Month.MonthName - @Model.Hadith.Week.WeekNumber. Hafta
            </div>
            <p class="hadith-content" id="hadithContent">@Model.Hadith.Content</p>
        }
    </div>

    <div class="language-tabs" id="languageTabs">
        @foreach (var language in Model.Languages)
        {
            <button type="button"
                    class="chip-btn @(language.Id == Model.SelectedLanguageId ? "active" : string.Empty)"
                    data-language="@language.Id">
                @language.Name
            </button>
        }
    </div>
</div>

@section Scripts {
<script>
    const state = {
        selectedYear: @Model.SelectedYear,
        selectedMonthId: @Model.SelectedMonthId,
        selectedWeekNumber: @Model.SelectedWeekNumber,
        selectedLanguageId: @Model.SelectedLanguageId
    };

    const yearSelect = document.getElementById('yearSelect');
    const monthSelect = document.getElementById('monthSelect');
    const weekTabs = document.getElementById('weekTabs');
    const languageTabs = document.getElementById('languageTabs');
    const hadithCard = document.getElementById('hadithCard');

    yearSelect?.addEventListener('change', async () => {
        state.selectedYear = Number(yearSelect.value);
        await refreshHadith(true);
    });

    monthSelect?.addEventListener('change', async () => {
        state.selectedMonthId = Number(monthSelect.value);
        await refreshHadith(true);
    });

    weekTabs?.addEventListener('click', async (event) => {
        const button = event.target.closest('button[data-week]');
        if (!button) return;
        state.selectedWeekNumber = Number(button.dataset.week);
        await refreshHadith(false);
    });

    languageTabs?.addEventListener('click', async (event) => {
        const button = event.target.closest('button[data-language]');
        if (!button) return;
        state.selectedLanguageId = Number(button.dataset.language);
        await refreshHadith(false);
    });

    async function refreshHadith(resetWeek) {
        if (resetWeek) {
            state.selectedWeekNumber = 1;
        }

        const query = new URLSearchParams({
            year: state.selectedYear,
            month: state.selectedMonthId,
            week: state.selectedWeekNumber,
            languageId: state.selectedLanguageId
        });

        const response = await fetch(`/Home/GetHadithData?${query.toString()}`);
        if (!response.ok) {
            hadithCard.innerHTML = '<div class="alert alert-danger mb-0">Veri alınamadı. Lütfen tekrar deneyin.</div>';
            return;
        }

        const data = await response.json();
        state.selectedYear = data.selectedYear;
        state.selectedMonthId = data.selectedMonthId;
        state.selectedWeekNumber = data.selectedWeekNumber;
        state.selectedLanguageId = data.selectedLanguageId;

        renderSelectOptions(yearSelect, data.years, 'yearNumber', 'yearNumber', state.selectedYear);
        renderSelectOptions(monthSelect, data.months, 'id', 'name', state.selectedMonthId);
        renderChipGroup(weekTabs, data.weeks, 'weekNumber', state.selectedWeekNumber, 'week', value => `${value}. Hafta`);
        renderChipGroup(languageTabs, data.languages, 'id', state.selectedLanguageId, 'language', value => data.languages.find(l => l.id === value).name);

        if (data.errorMessage) {
            hadithCard.innerHTML = `<div class="alert alert-warning mb-0">${data.errorMessage}</div>`;
            return;
        }

        if (!data.hadith) {
            hadithCard.innerHTML = '<div class="empty-state">Seçili filtreler için hadis bulunamadı.</div>';
            return;
        }

        hadithCard.innerHTML = `
            <div class="hadith-reference">${data.hadith.reference}</div>
            <p class="hadith-content">${data.hadith.content}</p>
        `;
    }

    function renderSelectOptions(selectEl, items, valueKey, textKey, selectedValue) {
        if (!selectEl) return;
        selectEl.innerHTML = items.map(item => {
            const value = item[valueKey];
            const selected = value === selectedValue ? 'selected' : '';
            return `<option value="${value}" ${selected}>${item[textKey]}</option>`;
        }).join('');
    }

    function renderChipGroup(container, items, valueKey, selectedValue, dataName, labelBuilder) {
        if (!container) return;
        container.innerHTML = items.map(item => {
            const value = item[valueKey];
            const active = value === selectedValue ? 'active' : '';
            const label = labelBuilder(value);
            return `<button type="button" class="chip-btn ${active}" data-${dataName}="${value}">${label}</button>`;
        }).join('');
    }
</script>
}
