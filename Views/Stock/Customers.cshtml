@model List<Alhadis.Models.Customer>
@{
    ViewData["Title"] = "Müşteriler";
}

@if (TempData["StockError"] != null)
{
    <div class="alert alert-danger">@TempData["StockError"]</div>
}

<div class="card p-3 mb-3">
    <h5>Yeni Müşteri</h5>
    <form asp-action="AddCustomer" method="post" class="row g-2">
        @Html.AntiForgeryToken()
        <div class="col-md-4"><input class="form-control" name="Name" placeholder="Ad Soyad" required /></div>
        <div class="col-md-3"><input class="form-control" name="Phone" placeholder="Telefon" /></div>
        <div class="col-md-3"><input class="form-control" name="Email" placeholder="E-posta" /></div>
        <div class="col-md-2"><button class="btn btn-primary w-100">Kaydet</button></div>
    </form>
</div>

<div class="card p-3">
    <h5>Müşteri Listesi</h5>
    <table class="table table-sm">
        <thead><tr><th>Ad</th><th>Telefon</th><th>E-posta</th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr><td>@c.Name</td><td>@c.Phone</td><td>@c.Email</td></tr>
        }
        </tbody>
    </table>
</div>
